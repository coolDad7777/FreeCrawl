# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional, for Groq AI provider.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Redis Configuration (Required for Crawl Jobs)
REDIS_URL="redis://localhost:6379"

# Rate Limiting
RATE_LIMIT_RPM=30
CACHE_TTL_HOURS=24
