# ─── Server ──────────────────────────────────────────────────────────────────
# Port to bind. FreeCrawl always listens on 0.0.0.0.
PORT=3000

# Set to "production" to serve the prebuilt dist/ instead of running Vite.
NODE_ENV=development

# When set, every /v1 request must send "Authorization: Bearer <key>".
# Comma-separated to allow several keys. Leave empty for an open local server.
FREECRAWL_API_KEY=

# ─── AI extraction (optional) ────────────────────────────────────────────────
# Needed only for the "json" scrape format and POST /v1/extract.
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq also has a free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider to use when a request does not name one.
AI_PROVIDER=gemini

# ─── Search ──────────────────────────────────────────────────────────────────
# Engines are tried in order until one returns results.
SEARCH_ENGINES=searxng,duckduckgo,bing

# A SearXNG instance with the JSON format enabled. This is the most reliable
# option: DuckDuckGo and Bing rate-limit datacenter IP ranges.
# Run one locally with: docker run -p 8080:8080 searxng/searxng
SEARXNG_URL=

# ─── Crawl jobs ──────────────────────────────────────────────────────────────
# Optional. With Redis, crawls run through BullMQ and can be spread over several
# worker processes. Without it, jobs run in the API process (still persisted).
REDIS_URL=

JOB_STORE_PATH=.freecrawl/jobs.sqlite
JOB_RETENTION_HOURS=24

# ─── Scraping ────────────────────────────────────────────────────────────────
SCRAPE_TIMEOUT_MS=30000
SCRAPE_MAX_BYTES=10485760
SCRAPE_CONCURRENCY=4
RESPECT_ROBOTS_TXT=true
BLOCK_MEDIA=true
USER_AGENT=

CRAWL_MAX_PAGES=5000
CRAWL_MAX_DEPTH=10

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
CACHE_PATH=.freecrawl/cache.sqlite
CACHE_MAX_ENTRIES=5000

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Requests per minute per API key (or per IP when no key is set). 0 disables it.
RATE_LIMIT_RPM=60

# ─── Danger zone ─────────────────────────────────────────────────────────────
# Allows scraping localhost and RFC1918 addresses. Required to crawl intranet
# hosts, and used by the test suite. Never enable on a public deployment:
# it re-opens server-side request forgery.
ALLOW_PRIVATE_URLS=false
